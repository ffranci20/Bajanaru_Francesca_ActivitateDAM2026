<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:id="@+id/main"
    android:background="#F8FAFD">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitlu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adauga_o_floare_noua"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etDenumire"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/denumire_floare"
            android:layout_marginTop="24dp"
            android:background="@android:drawable/editbox_background"
            app:layout_constraintTop_toBottomOf="@id/tvTitlu" />

        <CheckBox
            android:id="@+id/cbSpini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floarea_are_spini"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etDenumire" />

        <TextView
            android:id="@+id/tvMediu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mediu_de_crestere"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cbSpini"
            app:layout_constraintStart_toStartOf="parent"/>

        <RadioGroup
            android:id="@+id/rgMediu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvMediu">

            <RadioButton
                android:id="@+id/rbGradina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gradina"
                android:checked="true"
                android:layout_weight="1"/>

            <RadioButton
                android:id="@+id/rbGhiveci"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghiveci"
                android:layout_weight="1"/>
        </RadioGroup>

        <TextView
            android:id="@+id/tvCuloare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/culoare_dominanta"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/rgMediu"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spinnerCuloare"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/btn_dropdown"
            app:layout_constraintTop_toBottomOf="@id/tvCuloare"/>

        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rating_aspect_parfum"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/spinnerCuloare"
            app:layout_constraintStart_toStartOf="parent"/>

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvRating"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Switch
            android:id="@+id/swPerena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/este_o_planta_perena"
            android:layout_marginTop="24dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/ratingBar" />

        <Button
            android:id="@+id/btnSalvare"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/adauga_floare"
            android:textSize="18sp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/swPerena" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
